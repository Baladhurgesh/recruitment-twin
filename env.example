# Server-only. Never prefix these with NEXT_PUBLIC.
ELEVENLABS_API_KEY=your_elevenlabs_api_key
ELEVENLABS_AGENT_ID=your_private_agent_id

# Server-only. Emails messages left via the twin's leave_message tool.
RESEND_API_KEY=your_resend_api_key
MESSAGE_TO_EMAIL=you@example.com
# Optional. Defaults to onboarding@resend.dev, which can only send to your Resend account email.
MESSAGE_FROM_EMAIL=

# Public client config
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here
